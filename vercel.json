{
  "redirects": [
    { "source": "/impresion-3d-madrid", "destination": "/madrid", "permanent": true },
    { "source": "/impresion-3d-con-entrega-a-madrid", "destination": "/madrid", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
