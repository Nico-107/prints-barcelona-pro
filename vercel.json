{
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "dimension3dprints.com" }], "destination": "https://www.dimension3dprints.com/:path*", "permanent": true },
    { "source": "/impresion-3d-barcelona", "destination": "/", "permanent": true },
    { "source": "/ca/impressio-3d-barcelona", "destination": "/ca/", "permanent": true },
    { "source": "/impresion-3d-madrid", "destination": "/madrid", "permanent": true },
    { "source": "/impresion-3d-con-entrega-a-madrid", "destination": "/madrid", "permanent": true },
    { "source": "/catalogo/placa-mascota", "destination": "/catalogo/placa-nombre", "permanent": true },
    { "source": "/en", "destination": "/3d-printing-service", "permanent": false },
    { "source": "/de", "destination": "/de/3d-druck-service", "permanent": false },
    { "source": "/fr", "destination": "/fr/impression-3d-en-ligne", "permanent": false },
    { "source": "/it", "destination": "/it/stampa-3d-online", "permanent": false },
    { "source": "/nl", "destination": "/nl/3d-printen-laten-maken", "permanent": false },
    { "source": "/pt", "destination": "/pt/impressao-3d-online", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin-orders", "destination": "/index.html" },
    { "source": "/admin-makers", "destination": "/index.html" },
    { "source": "/internal", "destination": "/index.html" },
    { "source": "/catalogo/:slug*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }] },
    { "source": "/robots.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/llms.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/llms-full.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
  ]
}
