# PostHog client-side (required for analytics tracking)
VITE_POSTHOG_KEY=phc_your_project_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase (required for quote/checkout)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog server-side (required for npm run xp:report)
# Create a personal API key at https://eu.posthog.com/settings/user-api-keys
# Use read-only scope.
POSTHOG_PERSONAL_API_KEY=phx_your_personal_key_here
POSTHOG_PROJECT_ID=208342
